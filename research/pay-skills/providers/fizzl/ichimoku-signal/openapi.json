          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1h",
              "enum": [
                "1m",
                "3m",
                "5m",
                "15m",
                "30m",
                "1h",
                "2h",
                "4h",
                "6h",
                "8h",
                "12h",
                "1d",
                "3d",
                "1w",
                "1M"
              ]
            },
            "description": "Candle interval, e.g. 1h, 4h, 1d",
            "example": "1h"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "html"
              ],
              "default": "json"
            },
            "description": "Response format. 'html' returns a human-readable page (used by the browser paywall); agents should use the default JSON."
          }
        ],
        "responses": {
          "200": {
            "description": "Price levels and a long and a short plan. Levels from price history, not trade advice.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pair": {
                      "type": "string"
                    },
                    "interval": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "price": {
                      "type": "number"
                    },
                    "atr": {
                      "type": "number",
                      "description": "Average True Range (14, Wilder)"
                    },
                    "atr_percent": {
                      "type": "number"
                    },
                    "bias": {
                      "type": "string",
                      "enum": [
                        "long",
                        "short",
                        "none"
                      ],
                      "description": "From the confluence signal (/signals)"
                    },
                    "bias_from": {
                      "type": "string",
                      "example": "4 of 6 indicators bullish"
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "supports": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "price": {
                            "type": "number"
                          },
                          "touches": {
                            "type": "integer",
                            "description": "How often price turned at this level"
                          }
                        }
                      },
                      "description": "Up to 3 levels below the price, nearest first (swing lows, pivots)"
                    },
                    "resistances": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "price": {
                            "type": "number"
                          },
                          "touches": {
                            "type": "integer",
                            "description": "How often price turned at this level"
                          }
                        }
                      },
                      "description": "Up to 3 levels above the price, nearest first (swing highs, pivots)"
                    },
                    "pivots": {
                      "type": "object",
                      "description": "Classic pivots from the last completed candle",
                      "properties": {
                        "p": {
                          "type": "number"
                        },
                        "r1": {
                          "type": "number"
                        },
                        "r2": {
                          "type": "number"
                        },
                        "s1": {
                          "type": "number"
                        },
                        "s2": {
                          "type": "number"
                        }
                      }
                    },
                    "fibonacci": {
                      "type": "object",
                      "properties": {
                        "move": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        },
                        "swing_high": {
                          "type": "number"
                        },
                        "swing_low": {
                          "type": "number"
                        },
                        "retracements": {
                          "type": "object",
                          "properties": {
                            "0.382": {
                              "type": "number"
                            },
                            "0.5": {
                              "type": "number"
                            },
                            "0.618": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    },
                    "ichimoku": {
                      "type": "object",
                      "properties": {
                        "kijun_sen": {
                          "type": "number"
                        },
                        "cloud_top": {
                          "type": "number"
                        },
                        "cloud_bottom": {
                          "type": "number"
                        }
                      }
                    },
                    "plans": {
                      "type": "object",
                      "description": "Stop below the nearest support at least 0.5 ATR away (else 1.5 ATR, max 3 ATR); targets at the next resistances at least 1 ATR away (else +2 and +3 ATR). Short mirrors long.",
                      "properties": {
                        "long": {
                          "type": "object",
                          "properties": {
                            "entry": {
                              "type": "number"
                            },
                            "stop": {
                              "type": "number"
                            },
                            "target_1": {
                              "type": "number"
                            },
                            "target_2": {
                              "type": "number"
                            },
                            "risk_reward_1": {
                              "type": "number"
