      "count": 2004,
      "why": "name another URL in their 402 than the one requested",
      "short": "name the wrong URL in their 402",
      "fix": "build resource.url from your public origin (behind a TLS proxy: trust proxy, so it stays https)"
    },
    {
      "code": "testnet_only",
      "count": 159,
      "why": "offer only testnet payment options",
      "short": "are testnet only",
      "fix": "add a mainnet option (for example Base, eip155:8453) or delist the test endpoint"
    },
    {
      "code": "mpp_realm_mismatch",
      "count": 102,
      "why": "name another host as the MPP realm than the one they're served on",
      "short": "name the wrong MPP realm",
      "fix": "set realm to the public host name of the endpoint"
    },
    {
      "code": "price_above_advertised",
      "count": 74,
      "why": "charge more than their OpenAPI advertises",
      "short": "charge more than advertised",
      "fix": "keep the price in openapi.json in step with the 402"
    },
    {
      "code": "invalid_challenge",
      "count": 20,
      "why": "answer 402 without a valid x402 challenge",
      "short": "send a broken 402",
      "fix": "send the PaymentRequired object (base64 JSON in the PAYMENT-REQUIRED header, mirrored in the body)"
    },
    {
      "code": "mpp_no_expires",
      "count": 10,
      "why": "send an MPP challenge without an expiry",
      "short": "send MPP challenges without an expiry",
      "fix": "set expires on each challenge (a few minutes ahead), so a captured challenge cannot be replayed later"
    },
    {
      "code": "suspicious_amount",
      "count": 8,
      "why": "write the amount as dollars (\"0.01\") instead of atomic units",
      "short": "write dollars instead of atomic units",
      "fix": "use atomic units: \"10000\" is $0.01 USDC"
    },
    {
