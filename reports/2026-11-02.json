      "short": "ask for a non-USDC token",
      "fix": "use the network's USDC contract as the asset"
    },
    {
      "code": "server_error",
      "count": 154,
      "why": "answered with a server error (5xx): down or failing",
      "short": "answer with a server error",
      "fix": "check the server and its hosting (behind Cloudflare, a 52x or 530 means Cloudflare could not reach your origin)"
    },
    {
      "code": "testnet_only",
      "count": 128,
