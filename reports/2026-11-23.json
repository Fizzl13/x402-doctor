      "count": 1058,
      "why": "don't answer 402 at all, so there is nothing to pay",
      "short": "don't answer 402",
      "fix": "make the listed route answer 402 (a moved or renamed endpoint stays listed under its old URL until a payment goes through the new one)"
    },
    {
      "code": "resource_mismatch",
      "count": 899,
      "why": "name another URL in their 402 than the one requested",
      "short": "name the wrong URL in their 402",
      "fix": "build resource.url from your public origin (behind a TLS proxy: trust proxy, so it stays https)"
    },
    {
      "code": "unreachable",
