      "why": "timed out or could not be reached",
      "short": "are unreachable",
      "fix": "check that the host is up and answers within 10 seconds"
    },
    {
      "code": "retired",
      "count": 191,
      "why": "answer 410 Gone: the seller retired them",
      "short": "are retired (410 Gone)",
      "fix": "delist retired routes from the Bazaar and directories, or point them at the successor"
    },
    {
      "code": "host_disabled",
      "count": 182,
